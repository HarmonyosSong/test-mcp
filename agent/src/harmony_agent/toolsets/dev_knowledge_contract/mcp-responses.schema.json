{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:knowledge:mcp-responses",
  "$defs": {
    "_Counts": {
      "additionalProperties": false,
      "properties": {
        "products": {
          "minimum": 0,
          "title": "Products",
          "type": "integer"
        },
        "topics": {
          "minimum": 0,
          "title": "Topics",
          "type": "integer"
        },
        "sections": {
          "minimum": 0,
          "title": "Sections",
          "type": "integer"
        }
      },
      "required": [
        "products",
        "topics",
        "sections"
      ],
      "title": "_Counts",
      "type": "object"
    },
    "_Source": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "minLength": 1,
          "title": "Business Line",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "record_counts": {
          "$ref": "#/$defs/_Counts"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "relative_path",
        "record_counts"
      ],
      "title": "_Source",
      "type": "object"
    },
    "_Catalog": {
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "truncation": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Truncation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "filters": {
          "$ref": "#/$defs/_Filters"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/_Product"
          },
          "title": "Products",
          "type": "array"
        },
        "topic_count": {
          "minimum": 0,
          "title": "Topic Count",
          "type": "integer"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/_TopicSummary"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "status",
        "filters",
        "products",
        "topic_count",
        "topics"
      ],
      "title": "_Catalog",
      "type": "object"
    },
    "_Filters": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Line"
        },
        "product_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Product Id"
        },
        "path_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path Prefix"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "path_prefix"
      ],
      "title": "_Filters",
      "type": "object"
    },
    "_InvalidRequest": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "invalid_request",
          "title": "Status",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "status",
        "message"
      ],
      "title": "_InvalidRequest",
      "type": "object"
    },
    "_Product": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "minLength": 1,
          "title": "Business Line",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "boundaries": {
          "items": {
            "type": "string"
          },
          "title": "Boundaries",
          "type": "array"
        },
        "recognition_terms": {
          "items": {
            "type": "string"
          },
          "title": "Recognition Terms",
          "type": "array"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "name",
        "summary",
        "boundaries",
        "recognition_terms"
      ],
      "title": "_Product",
      "type": "object"
    },
    "_TooLarge": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "response_too_large",
          "title": "Status",
          "type": "string"
        },
        "truncated": {
          "const": true,
          "title": "Truncated",
          "type": "boolean"
        },
        "truncation": {
          "$ref": "#/$defs/_Truncation"
        }
      },
      "required": [
        "status",
        "truncated",
        "truncation"
      ],
      "title": "_TooLarge",
      "type": "object"
    },
    "_TopicSummary": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "minLength": 1,
          "title": "Business Line",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "topic_id": {
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "content_status": {
          "enum": [
            "supported",
            "evidence_limited"
          ],
          "title": "Content Status",
          "type": "string"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "topic_id",
        "title",
        "path",
        "summary",
        "content_status"
      ],
      "title": "_TopicSummary",
      "type": "object"
    },
    "_Truncation": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "max_response_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Response Bytes"
        },
        "omitted_topics": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omitted Topics"
        },
        "omitted": {
          "anyOf": [
            {
              "additionalProperties": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omitted"
        }
      },
      "required": [
        "reason",
        "next_action"
      ],
      "title": "_Truncation",
      "type": "object"
    },
    "_Candidate": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "minLength": 1,
          "title": "Business Line",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "topic_id": {
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "content_status": {
          "enum": [
            "supported",
            "evidence_limited"
          ],
          "title": "Content Status",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "recommended_sections": {
          "items": {
            "$ref": "#/$defs/_Recommended"
          },
          "title": "Recommended Sections",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "snippets": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/_Snippet"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippets"
        },
        "evidence_boundaries": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Boundaries"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "topic_id",
        "title",
        "path",
        "content_status",
        "confidence",
        "recommended_sections"
      ],
      "title": "_Candidate",
      "type": "object"
    },
    "_Recommended": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "support_status": {
          "enum": [
            "supported",
            "evidence_limited",
            "not_provided",
            "not_applicable"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "gap_reason": {
          "title": "Gap Reason",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "title",
        "support_status",
        "gap_reason"
      ],
      "title": "_Recommended",
      "type": "object"
    },
    "_Resolution": {
      "additionalProperties": false,
      "properties": {
        "credible_candidate_count": {
          "minimum": 0,
          "title": "Credible Candidate Count",
          "type": "integer"
        },
        "confidence": {
          "enum": [
            "high",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "credible_candidate_count",
        "confidence",
        "next_action"
      ],
      "title": "_Resolution",
      "type": "object"
    },
    "_Resolve": {
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "truncation": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Truncation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "resolved",
            "ambiguous",
            "not_found"
          ],
          "title": "Status",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/_Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Resolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "query",
        "candidates"
      ],
      "title": "_Resolve",
      "type": "object"
    },
    "_Snippet": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "support_status": {
          "enum": [
            "supported",
            "evidence_limited",
            "not_provided",
            "not_applicable"
          ],
          "title": "Support Status",
          "type": "string"
        },
        "gap_reason": {
          "title": "Gap Reason",
          "type": "string"
        },
        "finding_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Kind"
        }
      },
      "required": [
        "section_id",
        "item_id",
        "text",
        "truncated",
        "support_status",
        "gap_reason"
      ],
      "title": "_Snippet",
      "type": "object"
    },
    "_CodeLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "code",
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "frontend",
            "backend"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "code_source_id": {
          "minLength": 1,
          "title": "Code Source Id",
          "type": "string"
        },
        "service_ids": {
          "items": {
            "type": "string"
          },
          "title": "Service Ids",
          "type": "array"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        }
      },
      "required": [
        "kind",
        "source_id",
        "code_source_id",
        "service_ids",
        "symbols",
        "material_id",
        "relative_path",
        "start_line",
        "end_line"
      ],
      "title": "_CodeLocator",
      "type": "object"
    },
    "_CodeSource": {
      "additionalProperties": false,
      "properties": {
        "source_role": {
          "enum": [
            "frontend",
            "backend"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/_Repository"
        },
        "logical_services": {
          "items": {
            "$ref": "#/$defs/_LogicalService"
          },
          "title": "Logical Services",
          "type": "array"
        },
        "service_identity_status": {
          "enum": [
            "missing",
            "confirmed",
            "multiple"
          ],
          "title": "Service Identity Status",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/_Revision"
        }
      },
      "required": [
        "source_role",
        "repository",
        "logical_services",
        "service_identity_status",
        "revision"
      ],
      "title": "_CodeSource",
      "type": "object"
    },
    "_DocumentLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "product_document",
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "line_ranges": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Line Ranges",
          "type": "array"
        },
        "document_source": {
          "$ref": "#/$defs/_DocumentSource",
          "default": null
        }
      },
      "required": [
        "kind",
        "relative_path",
        "line_ranges"
      ],
      "title": "_DocumentLocator",
      "type": "object"
    },
    "_DocumentSource": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "product",
            "technical",
            "reference"
          ],
          "title": "Role",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "document_id",
        "role",
        "version",
        "content_sha256"
      ],
      "title": "_DocumentSource",
      "type": "object"
    },
    "_Include": {
      "additionalProperties": false,
      "properties": {
        "include_id": {
          "title": "Include Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        }
      },
      "required": [
        "include_id",
        "text",
        "section_ids"
      ],
      "title": "_Include",
      "type": "object"
    },
    "_Item": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "paragraph",
            "step",
            "bullet",
            "finding"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ref_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Ref Keys",
          "type": "array"
        },
        "finding_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Kind"
        }
      },
      "required": [
        "item_id",
        "type",
        "text",
        "source_ref_keys"
      ],
      "title": "_Item",
      "type": "object"
    },
    "_Key": {
      "additionalProperties": false,
      "properties": {
        "business_line": {
          "minLength": 1,
          "title": "Business Line",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "topic_id": {
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        }
      },
      "required": [
        "business_line",
        "product_id",
        "topic_id"
      ],
      "title": "_Key",
      "type": "object"
    },
    "_LogicalService": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "path_prefix": {
          "title": "Path Prefix",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "path_prefix",
        "evidence"
      ],
      "title": "_LogicalService",
      "type": "object"
    },
    "_MissingRead": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_found",
          "title": "Status",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/_Key"
        },
        "missing_section_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Section Ids"
        }
      },
      "required": [
        "status",
        "key"
      ],
      "title": "_MissingRead",
      "type": "object"
    },
    "_Read": {
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "truncation": {
          "anyOf": [
            {
              "$ref": "#/$defs/_Truncation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/_Key"
        },
        "topic": {
          "$ref": "#/$defs/_Topic"
        },
        "content_status": {
          "enum": [
            "supported",
            "evidence_limited"
          ],
          "title": "Content Status",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/_Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "source_catalog": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/_CodeLocator"
              },
              {
                "$ref": "#/$defs/_DocumentLocator"
              }
            ]
          },
          "title": "Source Catalog",
          "type": "object"
        },
        "code_sources": {
          "additionalProperties": {
            "$ref": "#/$defs/_CodeSource"
          },
          "title": "Code Sources",
          "type": "object"
        },
