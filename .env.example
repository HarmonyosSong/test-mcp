# demo: deterministic local diagnosis; model: PydanticAI + configured provider
HARMONY_AGENT_MODE=demo
HARMONY_AGENT_MODEL=openai:gpt-5.2
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
ARK_API_KEY=

# Comma-separated roots the read-only MCP server may inspect.
HARMONY_AGENT_ALLOWED_ROOTS=/absolute/path/to/your/HarmonyOS/project
HARMONY_AGENT_DATA_FILE=.data/cases.json
HARMONY_AGENT_REPOSITORY_DATA_FILE=.data/repositories.json
HARMONY_AGENT_GIT_MIRROR_DIR=.data/git-mirrors
HARMONY_AGENT_SNAPSHOT_DIR=.data/workspaces
HARMONY_AGENT_GIT_TIMEOUT_SECONDS=120
HARMONY_AGENT_STAGE_DELAY_MS=350
