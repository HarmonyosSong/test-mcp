# demo: no model configured (chat unavailable); model: PydanticAI + configured provider
HARMONY_AGENT_MODE=demo
HARMONY_AGENT_MODEL=openai:gpt-5.2
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
ARK_API_KEY=

# Comma-separated roots the read-only MCP server may inspect.
HARMONY_AGENT_ALLOWED_ROOTS=/absolute/path/to/your/HarmonyOS/project
HARMONY_AGENT_CONVERSATIONS_DATA_FILE=.data/conversations.json
HARMONY_AGENT_REPOSITORY_DATA_FILE=.data/repositories.json
HARMONY_AGENT_GIT_MIRROR_DIR=.data/git-mirrors
HARMONY_AGENT_SNAPSHOT_DIR=.data/workspaces
HARMONY_AGENT_GIT_TIMEOUT_SECONDS=120
HARMONY_AGENT_KNOWLEDGE_ROOT=knowledge
# 知识库查询日志（JSONL 追加，供未命中分析）；设为 off 关闭
HARMONY_AGENT_KNOWLEDGE_QUERY_LOG=.data/knowledge-queries.jsonl
HARMONY_AGENT_TOOL_FAILURE_LIMIT=10
# Per-turn total calls and consecutive calls without new information.
HARMONY_AGENT_TOOL_CALL_LIMIT=30
HARMONY_AGENT_TOOL_NO_PROGRESS_LIMIT=4
# Optional read-only external MCP. Omit to disable; never store credentials in this JSON.
# HARMONY_AGENT_DEV_KNOWLEDGE_CONFIG=.data/dev-knowledge.json
