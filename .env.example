# LLM配置
HARMONY_AGENT_MODE=model
HARMONY_AGENT_MODEL=openai:deepseek-v4.1-flash
# 写入 chat/completions 的 reasoning_effort（如 none / low / medium / high）；留空则不传
HARMONY_AGENT_REASONING_EFFORT=none
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
ARK_API_KEY=

# 日志&缓存目录配置
HARMONY_AGENT_ALLOWED_ROOTS=
HARMONY_AGENT_CONVERSATIONS_DATA_FILE=.data/conversations.json
HARMONY_AGENT_REPOSITORY_DATA_FILE=.data/repositories.json
HARMONY_AGENT_GIT_MIRROR_DIR=.data/git-mirrors
HARMONY_AGENT_SNAPSHOT_DIR=.data/workspaces
HARMONY_AGENT_GIT_TIMEOUT_SECONDS=120
HARMONY_AGENT_KNOWLEDGE_ROOT=knowledge

# 知识库查询日志（JSONL 追加，供未命中分析）；设为 off 关闭
HARMONY_AGENT_KNOWLEDGE_QUERY_LOG=.data/knowledge-queries.jsonl
HARMONY_AGENT_TOOL_FAILURE_LIMIT=10

# 单轮工具调用上限 / 连续无进展上限
HARMONY_AGENT_TOOL_CALL_LIMIT=30
HARMONY_AGENT_TOOL_NO_PROGRESS_LIMIT=4

# Agent 监听与本地前端联调（dev-web 代理到 API）
# HARMONY_AGENT_DEV_KNOWLEDGE_CONFIG=.data/dev-knowledge.json
HARMONY_MASTRA_HOST=127.0.0.1
HARMONY_MASTRA_PORT=8000
HARMONY_MASTRA_SERVE_WEB=false
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
HARMONY_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://127.0.0.1:5174,https://localhost:5174

# 知音楼sso配置
HARMONY_AGENT_RUN_MODE=local
HARMONY_AGENT_PUBLIC_BASE_URL=https://127.0.0.1:5174
HARMONY_AGENT_APP_PREFIX=/xesapp-agent
HARMONY_AGENT_SSO_BASE_URL=https://sso.zhiyinlou.com
HARMONY_AGENT_SSO_APP_ID=
HARMONY_AGENT_SSO_APP_KEY=

# A2A配置
HARMONY_AGENT_A2A_BASE_URL=https://dev-agent-fz.speiyou.com
HARMONY_AGENT_A2A_CLIENT_ID=xesapp-agent
HARMONY_AGENT_A2A_TOKEN=
HARMONY_AGENT_A2A_WAIT_SECONDS=600

# 知音楼IM配置
HARMONY_AGENT_YACH_ENABLED=false
HARMONY_AGENT_YACH_APP_KEY=
HARMONY_AGENT_YACH_APP_SECRET=
HARMONY_AGENT_YACH_BASE_URL=https://yach-oapi.zhiyinlou.com
HARMONY_AGENT_YACH_ROBOT_ID=

# 学员编号 → uid
HARMONY_AGENT_UCENTER_BASE_URL=https://ucenter-one-inner.speiyou.cn
HARMONY_AGENT_UCENTER_TIMEOUT_MS=10000

# log-mcp（独立进程：8766；日志存储路径： data/log-mcp/logs/log-mcp-YYYY-MM-DD_HH-MM-SS.log）
LOG_MCP_AUTH_DISABLED=true # 本地 true；容器须 false + HOST=0.0.0.0
LOG_MCP_TIMEOUT_MS=30000
LOG_MCP_HOST=127.0.0.1
LOG_MCP_PORT=8766
LOG_MCP_URL=http://127.0.0.1:8766/mcp
LOG_MCP_BEARER_TOKEN=
LOG_MCP_ENV=prod

# 日志中心云网关凭据（测试应用不支持查日志中心，仅生产支持）
# 生产
LOG_MCP_PROD_APPID=
LOG_MCP_PROD_BASE_URL=https://logcenter-api.tal.com/api
LOG_MCP_PROD_APPSECRET=
# 测试
LOG_MCP_TEST_APPID=
LOG_MCP_TEST_BASE_URL=https://logcenter-api-test.tal.com/api
LOG_MCP_TEST_APPSECRET=

# 阿里云日志默认坐标（topic动态获取）
LOG_MCP_CLOUDLOG_VENDOR=aliyun
LOG_MCP_CLOUDLOG_REGION=cn-beijing
LOG_MCP_CLOUDLOG_ACCOUNT=
LOG_MCP_CLOUDLOG_COLLECTION=

# git凭证
ANALYSIS_GIT_USERNAME=
ANALYSIS_GIT_TOKEN=

# 学员模拟登录 Token（cloudlearn-devtools API MCP；URL+Token 均非空才挂载）
API_MCP_URL=
API_MCP_TOKEN=

# 私有 COS（Token 二维码上传；四要素全空关闭，缺一启动失败）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_PREFIX=troubleshoot-odyssey/test
COS_SIGNED_URL_TTL_SECONDS=900