# Mastra runtime. Requires Node.js >=22.13.0.
HARMONY_MASTRA_HOST=127.0.0.1
HARMONY_MASTRA_PORT=8000
HARMONY_MASTRA_DATA_DIR=.data/mastra
HARMONY_MASTRA_SERVE_WEB=false
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
HARMONY_AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://127.0.0.1:5174,https://localhost:5174
HARMONY_MASTRA_MCP_COMMAND=uv
HARMONY_MASTRA_SKILLS_DIR=skills
HARMONY_MASTRA_GIT_MIRROR_DIR=.data/git-mirrors
HARMONY_MASTRA_SNAPSHOT_DIR=.data/workspaces
HARMONY_AGENT_MODEL_CONFIG_FILE=.data/model-config.json
# Optional remote log catalog (Aliyun SLS via logcenter). Empty credentials = tools not mounted.
# HARMONY_AGENT_LOG_CATALOG=runtime/contracts/log-catalog/catalog.yaml
HARMONY_AGENT_LOGCENTER_APP_ID=
HARMONY_AGENT_LOGCENTER_APP_SECRET=
HARMONY_AGENT_LOGCENTER_BASE_URL=https://logcenter-api.tal.com/api
HARMONY_AGENT_LOGCENTER_TIMEOUT_MS=15000

HARMONY_AGENT_KNOWLEDGE_QUERY_LOG=.data/knowledge-queries.jsonl
HARMONY_AGENT_KNOWLEDGE_CASES_DIR=.data/knowledge-cases
HARMONY_AGENT_KNOWLEDGE_RETRIEVAL_MODE=legacy
HARMONY_AGENT_KNOWLEDGE_PREVIEW_STRATEGY=

# Zhiyinlou web SSO (secrets stay in local .env only — never commit real values)
# RUN_MODE=local skips SSO for local dev; server (default) requires Zhiyinlou SSO.
# Production (.env-prd) must use server.
HARMONY_AGENT_RUN_MODE=local
# PUBLIC_BASE_URL is browser origin only (no /xesapp-agent path).
HARMONY_AGENT_PUBLIC_BASE_URL=https://127.0.0.1:5174
HARMONY_AGENT_APP_PREFIX=/xesapp-agent
HARMONY_AGENT_SSO_BASE_URL=https://sso.zhiyinlou.com
HARMONY_AGENT_SSO_APP_ID=
HARMONY_AGENT_SSO_APP_KEY=

# Optional model defaults. Values in the web settings take precedence and are stored in
# .data/model-config.json with owner-only permissions (0600).
HARMONY_AGENT_MODE=demo
HARMONY_AGENT_MODEL=deepseek:deepseek-flash
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
ARK_API_KEY=

# Comma-separated roots the read-only repository tools may inspect.
HARMONY_AGENT_ALLOWED_ROOTS=/absolute/path/to/your/HarmonyOS/project
HARMONY_AGENT_KNOWLEDGE_ROOT=knowledge

# Compass A2A client (P0). Basics are non-secret; put the real Token only in local .env.
# BASE_URL must be origin only (no /compass path). Empty TOKEN disables the client.
# The runtime keeps the client knowledge MCP locally; the cloud-learning Agent is reached through A2A.
HARMONY_AGENT_A2A_BASE_URL=https://dev-agent-fz.speiyou.com
HARMONY_AGENT_A2A_CLIENT_ID=xesapp-agent
HARMONY_AGENT_A2A_TOKEN=
HARMONY_AGENT_A2A_WAIT_SECONDS=180

# Zhiyinlou digital partner IM via yach-cli (event + im). Secrets only in local .env — never commit.
# See spec/yach-cli-channel.md. Requires yach-cli on PATH (or set CLI_PATH). Single replica for event Bus.
HARMONY_AGENT_YACH_ENABLED=false
HARMONY_AGENT_YACH_APP_KEY=
HARMONY_AGENT_YACH_APP_SECRET=
# HARMONY_AGENT_YACH_CLI_PATH=yach-cli
HARMONY_AGENT_YACH_ROBOT_ID=
